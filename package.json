{
  "name": "waterman",
  "version": "1.0.0",
  "type": "module",
  "description": "Waterman is a watersports monitoring system that grabs weather forecasts and notifies users when conditions will suit their needs.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run && npm run test:fx && npm run test:convex && npm run test:email",
    "test:fx": "node --test tests/forecast-experiment/*.test.mjs",
    "test:convex": "node --test tests/convex/*.test.mjs",
    "test:email": "node --test tests/email-worker/*.test.mjs",
    "verify:convex": "node scripts/verify-convex-reads.mjs",
    "fx:fetch:openmeteo": "node scripts/fx-fetch-openmeteo-runs.mjs",
    "fx:fetch:observations": "node scripts/fx-fetch-observations.mjs",
    "fx:backfill:windguru": "node scripts/fx-backfill-windguru-history.mjs",
    "fx:backfill:openmeteo": "node scripts/fx-backfill-openmeteo-previous-runs.mjs",
    "fx:purge:forecast-gaps": "node scripts/fx-purge-forecast-gaps.mjs",
    "fx:build:labels": "node scripts/fx-build-labels.mjs",
    "fx:backfill:regimes": "node scripts/fx-backfill-day-regimes.mjs",
    "fx:score:models": "node scripts/fx-score-models.mjs",
    "fx:score:predictions": "node scripts/fx-score-predictions.mjs",
    "fx:analyze:model-skill": "node scripts/fx-analyze-model-skill.mjs",
    "fx:analyze:nortada-winds": "node scripts/fx-analyze-nortada-winds.mjs",
    "fx:mine:bay": "node scripts/fx-mine-bay-coefficients.mjs",
    "fx:backtest:predictions": "node scripts/fx-backtest-predictions.mjs",
    "fx:backtest:analog-kickin": "node scripts/fx-backtest-analog-kickin.mjs",
    "fx:nowcast:uplift": "node scripts/fx-nowcast-uplift-backtest.mjs",
    "fx:verify:nowcast-loop": "node scripts/fx-verify-nowcast-loop.mjs",
    "fx:export:ml-dataset": "node scripts/fx-export-ml-dataset.mjs",
    "fx:export:nowcast-dataset": "node scripts/fx-export-ml-dataset.mjs -- --all-presets --nowcast --season average",
    "fx:train:bay-ml": "ml/bay-wind/.venv/bin/python ml/bay-wind/train.py",
    "fx:train:bay-nowcast-ml": "ml/bay-wind/.venv/bin/python ml/bay-wind/train.py --nowcast",
    "fx:predict": "node scripts/fx-generate-predictions.mjs",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "email:install": "npm --prefix workers/email ci",
    "email:dev": "npm --prefix workers/email run dev",
    "email:deploy": "npm --prefix workers/email run deploy",
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "scrape": "node scripts/scrape.mjs",
    "postinstall": "npx puppeteer browsers install chrome || true",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "@aws-sdk/lib-storage": "^3.1029.0",
    "convex": "^1.30.0",
    "convex-helpers": "^0.1.113",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "framer-motion": "^12.29.2",
    "groq-sdk": "^0.7.0",
    "hls.js": "^1.6.15",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.556.0",
    "next": "^16.0.7",
    "puppeteer": "^24.32.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "autoprefixer": "^10.4.22",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vitest": "^3.2.7"
  }
}
